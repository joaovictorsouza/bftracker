# Copie para .env (ou rode ./scripts/setup.sh, que gera as senhas) e ajuste.
# NUNCA envie o .env para o repositório.

# --- obrigatório -------------------------------------------------------------
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
# mínimo de 8 caracteres; vazio = uma senha é gerada e mostrada no log do serviço app
ADMIN_PASSWORD=
ADMIN_EMAIL=
# chave que assina sessões e cifra segredos; vazio = gerada no volume de dados
SECRET_KEY=

# --- endereço ----------------------------------------------------------------
# Para HTTPS (e push) use um domínio apontando para o VPS. Sem domínio próprio,
# serve <IP-com-hifens>.sslip.io, ex.: 203-0-113-10.sslip.io
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
TIMEZONE=America/Sao_Paulo

# --- e-mail (também configurável pela interface) ----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# --- WhatsApp (waha | evolution | meta | callmebot | webhook) ----------------
WHATSAPP_PROVIDER=
WAHA_API_KEY=
# EVOLUTION_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# META_WA_TOKEN=
# META_WA_PHONE_ID=
# META_WA_TEMPLATE=
# WHATSAPP_WEBHOOK_URL=

# --- Mercado Livre (API oficial, opcional) -----------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# --- ajustes finos -----------------------------------------------------------
MIN_INTERVAL_MINUTES=5
WORKER_CONCURRENCY=3
HOST_MIN_DELAY_SECONDS=2.5
