# Variáveis de ambiente para a aba "Environment" do serviço Compose no Dokploy
# (ou copie para .env em uso local; NUNCA envie segredos para o repositório).
# Dica: rode ./scripts/setup.sh ofertas.seudominio.com voce@exemplo.com para gerar valores prontos.

# --- obrigatório no Dokploy --------------------------------------------------
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
# mínimo de 8 caracteres; vazio = uma senha é gerada e mostrada no log do serviço app
ADMIN_PASSWORD=
# usado no VAPID (Web Push no iPhone/Android) e no cadastro inicial do admin
ADMIN_EMAIL=
# chave que assina sessões e cifra segredos; vazio = gerada no volume app-data
SECRET_KEY=

# --- domínio público (HTTPS via Dokploy + Cloudflare -> habilita Web Push) ---
PUBLIC_URL=https://ofertas.seudominio.com
TIMEZONE=America/Sao_Paulo

# --- e-mail SMTP (também configurável pela interface) ------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# --- WhatsApp (waha | evolution | meta | callmebot | webhook) ----------------
WHATSAPP_PROVIDER=
WAHA_API_KEY=
# EVOLUTION_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# META_WA_TOKEN=
# META_WA_PHONE_ID=
# META_WA_TEMPLATE=
# WHATSAPP_WEBHOOK_URL=

# --- X / Twitter (ofertas para produtos cadastrados e perfis) ----------------
# Bearer Token da API v2 (developer.x.com) ou Consumer Key + Secret:
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCOUNTS=pelandobr,promobitoficial,pechinchou,nerdofertas,achadosdotb,ofertasadrena,pcdofafa
# Opcional: ponte RSS de busca com {query}, ex.: https://seu-rsshub/twitter/keyword/{query}
X_RSS_SEARCH_URL=

# --- Busca Web opcional (cobre ML sem API oficial, OLX, HardMob e X) ---------
# Serper.dev (Google Shopping + Web, 2.500 buscas grátis na hora) ou Brave Search:
SERPER_API_KEY=
BRAVE_API_KEY=

# --- Alertas por E-mail via IMAP (opcional, somente leitura) -----------------
# Lê avisos automáticos de buscas salvas na OLX, fórum HardMob, Google Alerts e ML:
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Mercado Livre (API oficial, opcional — NÃO obrigatória) -----------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# --- ajustes finos -----------------------------------------------------------
MIN_INTERVAL_MINUTES=5
WORKER_CONCURRENCY=3
HOST_MIN_DELAY_SECONDS=2.5
